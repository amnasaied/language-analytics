# install.packages("topics")
library(topics)
set.seed(999)
reviews <- read.csv('Product Reviews.csv') %>%
filter(!is.na(Content), Content != "", nchar(Content) > 0) %>%
filter(Brand %in% c("Amazon", "Asus", "Apple", "Coby", "Samsung")) %>%
filter(Brand != "Amazon" | runif(n()) < 0.50) %>% # Remove 50% of Amazon reviews randomly
filter(Rating != 5 | runif(n()) < 0.60) # Then remove 40% of 5-star reviews randomly
View(reviews)
cat("Total reviews:", nrow(reviews), "\n")
cat("Brands:", paste(unique(reviews$Brand), collapse = ", "), "\n")
reviews %>%
group_by(Brand) %>%
summarise(count = n()) %>%
print()
ggplot(data = reviews, aes(x = Rating))+
geom_bar(fill = "steelblue", color = "white")+
theme_light()
set.seed(42)
corp <- corpus(reviews, text_field = "Content")
dfmt <- corp %>%
tokens(remove_punct = TRUE, remove_numbers = TRUE) %>%
tokens_tolower() %>%
tokens_remove(stopwords("english")) %>%
tokens_wordstem() %>%
dfm() %>%
dfm_trim(min_docfreq = 5, docfreq_type = "count")
cat("DFM dimensions:", nrow(dfmt), "documents ×", ncol(dfmt), "features\n")
