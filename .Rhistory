url <- "https://www.airlinequality.com/airline-reviews/emirates/?sortby=post_date%3ADesc&pagesize=50"
page <- read_html(url)
titles <- page %>% html_nodes(".text_header") %>% html_text(trim = TRUE)
reviews <- page %>% html_nodes(".text_content") %>% html_text(trim = TRUE)
ratings <- page %>% html_nodes(".rating-10") %>% html_attr("class") %>%
str_extract("\\d+") %>% as.numeric()
df <- tibble(title = titles, text = reviews, rating = ratings / 2)
