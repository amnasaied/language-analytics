# Load image
img <- load.image("~/TUM Study/Marketing Analytics/images/popular_5.jpeg")
# Convert to data frame
df_rgb <- as.data.frame(img)
View(df_rgb)
# Pivot to wide format for RGB channels
df_rgb_wide <- df_rgb %>%
pivot_wider(names_from = cc, values_from = value) %>%
rename(
R = `1`,
G = `2`,
B = `3`
)
# Reshape to long format for plotting
df_long <- df_rgb_wide %>%
pivot_longer(cols = c(R, G, B), names_to = "Channel", values_to = "Value")
